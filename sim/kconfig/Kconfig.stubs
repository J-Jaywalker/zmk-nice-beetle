# Zephyr / SoC level symbols that ZMK and this repo reference.  Only the
# symbols that change what the simulated firmware compiles are defined here;
# everything else evaluates to n exactly as an undefined symbol would.

# --- nRF52840 (nice!nano v2) SoC facts ---
config SOC_SERIES_NRF52X
	bool
config SOC_NRF52840_QIAA
	bool
config HAS_HW_NRF_USBD
	def_bool y
config CPU_HAS_FPU
	def_bool y
config ARCH_POSIX
	bool
config ARM_MPU
	bool
config PINCTRL
	bool
config GPIO
	bool
config USE_DT_CODE_PARTITION
	bool
config BUILD_OUTPUT_UF2
	bool
config MPU_ALLOW_FLASH_WRITE
	bool
config NVS
	bool
config FLASH
	bool
config FLASH_PAGE_LAYOUT
	bool
config FLASH_MAP
	bool
config SOC_DCDC_NRF52X
	bool
config SOC_DCDC_NRF52X_HV
	bool

