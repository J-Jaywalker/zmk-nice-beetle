if SHIELD_NICE_EPAPER

config LV_Z_VDB_SIZE
    default 100

config LV_DPI_DEF
    default 161

config LV_Z_BITS_PER_PIXEL
    default 1

choice LV_COLOR_DEPTH
    default LV_COLOR_DEPTH_1
endchoice

choice ZMK_DISPLAY_WORK_QUEUE
    default ZMK_DISPLAY_WORK_QUEUE_DEDICATED
endchoice

choice ZMK_DISPLAY_STATUS_SCREEN
    default ZMK_DISPLAY_STATUS_SCREEN_CUSTOM
endchoice

# LVGL 9 objects and draw tasks are larger than LVGL 8's; ZMK's own nice_view custom screen
# uses 8192 since the LVGL 9 update, and this screen has more objects than that one.
config LV_Z_MEM_POOL_SIZE
    default 8192 if ZMK_DISPLAY_STATUS_SCREEN_CUSTOM

config ZMK_DISPLAY_STATUS_SCREEN_CUSTOM
    imply NICE_VIEW_WIDGET_STATUS

config NICE_OLED_GEM_WPM_FIXED_RANGE
    bool "Enable fixed range for WPM gauge/chart"
    default y

config NICE_OLED_GEM_WPM_FIXED_RANGE_MAX
    int "Fixed range maximum for WPM gauge/chart"
    default 100

config NICE_OLED_GEM_ANIMATION
    bool "Enable animation on peripheral"
    default y

config NICE_OLED_GEM_ANIMATION_MS
    int "Animation length in milliseconds"
    default 960

# LVGL 9: LV_USE_IMG is now LV_USE_IMAGE and LV_USE_ANIMATION no longer exists (animations are
# always available). No built-in LVGL fonts are needed: all text uses pixel_operator_mono.
config NICE_VIEW_WIDGET_STATUS
    select LV_USE_LABEL
    select LV_USE_IMAGE
    select LV_USE_CANVAS
    select LV_USE_ANIMIMG

config NICE_VIEW_WIDGET_INVERTED
    bool "Invert display colors"

config NICE_BEETLE_DITHER_BEEDLY
    bool "Enable dithering on Beedly animation"
    default n

if !ZMK_SPLIT || ZMK_SPLIT_ROLE_CENTRAL

config NICE_VIEW_WIDGET_STATUS
    select ZMK_WPM

# ZMK_WPM stays selected: the fallback below uses it, and so may other modules/configs. With the
# typing-only counter its zmk_wpm_state_changed events are simply not used by these widgets.
config NICE_BEETLE_WPM_TYPING_ONLY
    bool "WPM (number, graph, Beedly) counts typing keys only"
    default y
    help
      Count only letters, digits, symbols/punctuation, Space, Tab, Enter and keypad
      digits/operators/Enter for the central screen's WPM; modifiers, Backspace/Delete, Esc,
      arrows/navigation, F-keys, lock keys and media keys do not count. Same algorithm as ZMK's
      counter otherwise (key releases, 5 keys = 1 word, 1 s update, 5 s window).
      n = show ZMK's own WPM (every key release counts).

# Central Beedly (replaces the Luna dog; widgets/beedly_slot.c). The animations are the tags of
# sprite_assets/ase/beedly_left.aseprite. Durations are PER FRAME, so a tag with more frames plays
# longer instead of faster.

config NICE_BEETLE_LUNA_WALK_WPM
    int "WPM at which the central Beedly switches from Idle to Walk"
    default 15

config NICE_BEETLE_LUNA_SPRINT_WPM
    int "WPM at which the central Beedly switches from Walk to Sprint"
    default 70

config NICE_BEETLE_LUNA_IDLE_FRAME_MS
    int "Central Beedly Idle animation: milliseconds per frame"
    default 960

config NICE_BEETLE_LUNA_WALK_FRAME_MS
    int "Central Beedly Walk animation: milliseconds per frame"
    default 200

config NICE_BEETLE_LUNA_SPRINT_FRAME_MS
    int "Central Beedly Sprint animation: milliseconds per frame"
    default 200

config NICE_BEETLE_LUNA_MODIFIER_FRAME_MS
    int "Central Beedly Shift/Ctrl/Alt animations: milliseconds per frame"
    default 600

config NICE_BEETLE_LUNA_CAPSLOCK_FRAME_MS
    int "Central Beedly Caps Lock animation: milliseconds per frame"
    default 300

endif # !ZMK_SPLIT || ZMK_SPLIT_ROLE_CENTRAL

endif # SHIELD_NICE_EPAPER
